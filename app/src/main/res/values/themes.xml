<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GuildBoard" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceContainer">@color/card_dark</item>
        <item name="colorSurfaceContainerHigh">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_white</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>

        <!-- Popup Menu Theme -->
        <item name="popupTheme">@style/CustomPopupMenuTheme</item>
        <item name="android:popupTheme">@style/CustomPopupMenuTheme</item>
    </style>

    <style name="Theme.GuildBoard" parent="Base.Theme.GuildBoard" />

    <!-- Custom dark theme wrapper for PopupMenu -->
    <style name="CustomPopupMenuTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorBackground">@color/card_dark</item>
        <item name="colorBackgroundFloating">@color/card_dark</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorSurfaceContainer">@color/card_dark</item>
        <item name="android:itemBackground">@color/card_dark</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textColorSecondary">@color/accent_gold</item>
    </style>
</resources>