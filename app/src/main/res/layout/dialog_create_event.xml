<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zorganizuj Spotkanie"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nazwa gry / wydarzenia"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="np. Epicka Sesja D&amp;D"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Miasto"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etEventCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="np. Kraków"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Adres lokalu"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etEventAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="np. ul. Długa 5 (Klub HEX)"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Data i godzina"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etEventDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="np. 2023-11-05 18:00"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Szczegółowy opis"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etEventDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="Kto co przynosi, jakie zasady..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDoCreateEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent_gold"
            android:text="Utwórz spotkanie"
            android:textColor="@color/bg_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCloseCreateEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Anuluj"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>