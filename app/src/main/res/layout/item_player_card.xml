<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivPlayerAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Avatar gracza"
            android:src="@drawable/ic_user_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvPlayerNick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Piotr_RPG"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mistrz Gry • Zaawansowany"
                android:textColor="@color/accent_gold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPlayerDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lokalizacja: Kraków (2.5 km)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerOwnedGames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Possiadam: Nemesis, Gloomhaven, Brass Birmingham"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnInvitePlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/accent_gold"
        android:text="Zaproś do gry / Wiadomość"
        android:textColor="@color/bg_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>