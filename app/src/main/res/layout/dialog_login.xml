<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= FORMULARZ LOGOWANIA ================= -->
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel Logowania GuildBoard"
                android:textColor="@color/accent_gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zaloguj się, aby tworzyć stoły i dołączać do czatu"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="E-mail lub Nick gracza"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="np. jan_gracz lub jan@example.com"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hasło"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDoLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent_gold"
                android:text="Zaloguj się"
                android:textColor="@color/bg_dark"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSwitchToRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/surface_dark"
                android:text="Nie masz konta? Zarejestruj się"
                android:textColor="@color/text_white" />

            <TextView
                android:id="@+id/tvCloseLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:text="Anuluj"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ================= FORMULARZ REJESTRACJI ================= -->
        <LinearLayout
            android:id="@+id/layoutRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rejestracja Nowego Konta"
                android:textColor="@color/accent_gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dołącz do społeczności graczy planszówek i RPG!"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Nick -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nazwa użytkownika (Nick)"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRegisterNick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="np. Jan_Gracz"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Adres E-mail"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="jan@example.com"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <!-- Hasło -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hasło"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <!-- Rola i doświadczenie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rola w grach"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Gracz"
                    android:textColor="@color/text_white"
                    android:buttonTint="@color/accent_gold" />

                <RadioButton
                    android:id="@+id/rbGm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Mistrz Gry"
                    android:textColor="@color/text_white"
                    android:buttonTint="@color/accent_gold" />

                <RadioButton
                    android:id="@+id/rbOrganizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Organizator"
                    android:textColor="@color/text_white"
                    android:buttonTint="@color/accent_gold" />
            </RadioGroup>

            <!-- Posiadane gry -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Twoje ulubione / posiadane gry (opcjonalne)"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRegisterGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="np. Catan, Nemesis, Gloomhaven"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDoRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent_gold"
                android:text="Utwórz konto i zaloguj"
                android:textColor="@color/bg_dark"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSwitchToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/surface_dark"
                android:text="Masz już konto? Zaloguj się"
                android:textColor="@color/text_white" />

            <TextView
                android:id="@+id/tvCloseRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:text="Anuluj"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>