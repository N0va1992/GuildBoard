<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="10dp">

    <!-- ZABLOKOWANY CZAT (Gdy niezalogowany) -->
    <LinearLayout
        android:id="@+id/layoutChatLocked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/accent_gold"
            android:contentDescription="Czat Zablokowany" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Czat Dostępny Dla Zalogowanych"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Zaloguj się lub utwórz konto, aby uzyskać dostęp do czatu stolika i komunikować się z innymi graczami."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnLoginForChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent_gold"
            android:text="Zaloguj się / Utwórz konto"
            android:textColor="@color/bg_dark"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ODBLOKOWANY CZAT (Gdy zalogowany) -->
    <LinearLayout
        android:id="@+id/layoutChatContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Nagłówek czatu i status połączenia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_dark"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/vStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/accent_green" />

            <TextView
                android:id="@+id/tvWsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Czat: Nemesis Lockdown (Połączono)"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lista wiadomości czatu -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/surface_dark"
            android:padding="8dp" />

        <!-- Formularz wysyłania wiadomości -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Wpisz treść wiadomości..."
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnSendMessage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/accent_gold"
                android:contentDescription="Wyślij wiadomość"
                android:src="@drawable/ic_send"
                app:tint="@color/bg_dark" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>