<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- ================= 1. PRZEGLĄDANIE PUBLICZNYCH GILDII ================= -->
    <LinearLayout
        android:id="@+id/layoutBrowseGuilds"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Nagłówek i przycisk tworzenia gildii -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gildie i Grupy Graczy"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCreateGuild"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent_gold"
                android:text="+ Stwórz Gildię"
                android:textColor="@color/bg_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wyszukiwarka gildii -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etSearchGuild"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_muted"
                android:hint="Szukaj gildii po nazwie lub mieście..."
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Lista Gildii -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGuilds"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- ================= 2. STRONA MOJEJ GILDII (Gdy zalogowany należy do gildii) ================= -->
    <LinearLayout
        android:id="@+id/layoutMyGuild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Karta Nagłówkowa Mojej Gildii -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_guild"
                    app:tint="@color/accent_gold"
                    android:background="@drawable/bg_chip"
                    android:padding="8dp"
                    android:contentDescription="Ikona Mojej Gildii" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvMyGuildName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nazwa Mojej Gildii"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMyGuildRoleAndMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rola: Właściciel | Kraków | 18 Członków"
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnBrowseAllGuilds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_dark"
                    android:text="Inne gildie"
                    android:textColor="@color/text_white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnLeaveGuild"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#8B0000"
                    android:text="Opuść gildię"
                    android:textColor="@color/text_white"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Pasek nawigacyjny sekcji (Czat | Członkowie | Gry Gildii | Zarządzanie) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipGuildChat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/accent_gold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="💬 Czat Gildii"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipGuildMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="👥 Członkowie"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipGuildGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🎲 Gry Gildii"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipGuildManage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="⚙️ Zarządzanie &amp; Prośby"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:visibility="visible" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- SEKCJA 1: CZAT GILDII -->
        <LinearLayout
            android:id="@+id/secGuildChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuildChatMessages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/surface_dark"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etGuildMessageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Napisz do członków gildii..."
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnSendGuildMessage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="@color/accent_gold"
                    android:contentDescription="Wyślij"
                    android:src="@drawable/ic_send"
                    app:tint="@color/bg_dark" />
            </LinearLayout>
        </LinearLayout>

        <!-- SEKCJA 2: CZŁONKOWIE GILDII -->
        <LinearLayout
            android:id="@+id/secGuildMembers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMyGuildMembers"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- SEKCJA 3: GRY GILDII -->
        <LinearLayout
            android:id="@+id/secGuildGames"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etAddGuildGame"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Dodaj tytuł gry do listy..."
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnAddGuildGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/accent_gold"
                    android:text="+ Dodaj"
                    android:textColor="@color/bg_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuildGames"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- SEKCJA 4: ZARZĄDZANIE & PROŚBY (Widoczne tylko dla Właściciela / Moderatora) -->
        <LinearLayout
            android:id="@+id/secGuildManage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oczekujące Prośby o Dołączenie"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingMembers"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zarządzanie Rolami i Członkami"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvManageMembers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>