<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivGameThumbnail"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="#333842"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_games"
            android:padding="8dp"
            android:contentDescription="Miniatura BGG" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tytuł gry (z BGG)"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEventDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opis sesji / poziom zaawansowania"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvEventDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kiedy: 2023-10-20 18:00"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEventAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gdzie: Kraków, ul. Batorego 15"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDistanceAndSeats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Miejsca: 3/5"
                android:textColor="@color/accent_gold"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvUserStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:padding="6dp"
        android:text="Twój status: Może będę (Gracz)"
        android:textColor="@color/accent_gold"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnJoinEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_green"
            android:text="Dołącz do spotkania"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/surface_dark"
            android:text="Otwórz czat (WS)"
            android:textColor="@color/accent_gold"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>