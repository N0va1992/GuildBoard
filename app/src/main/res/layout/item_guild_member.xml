<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_rounded_card"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_user_avatar"
        android:contentDescription="Avatar członka" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvMemberNick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jan_Gracz"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMemberRoleAndStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rola: MODERATOR | Status: Zaakceptowano"
            android:textColor="@color/accent_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Przycisk Akcji Moderatora / Właściciela -->
    <Button
        android:id="@+id/btnMemberAction"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:backgroundTint="@color/surface_dark"
        android:text="Opcje"
        android:textColor="@color/accent_gold"
        android:textSize="10sp"
        android:paddingHorizontal="8dp" />

</LinearLayout>